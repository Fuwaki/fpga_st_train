{
  "run": {
    "name": "film_h4",
    "output_dir": "../trials/film_h4",
    "seed": 0,
    "device": "d0",
    "log_every": 100,
    "val_every": 200,
    "val_batch_size": 8,
    "checkpoint_every": 1000,
    "sample_every": 500,
    "sample_content": "../../../../style-transfer/demo_inputs",
    "sample_size": 384
  },
  "data": {
    "content_dir": "../../../../style-transfer/demo_inputs",
    "hf": {
      "repo": "detection-datasets/coco",
      "split": "train",
      "max_shards": 10
    },
    "pseudo_gt_dir": null,
    "crop": 192,
    "batch_size": 32,
    "limit": null
  },
  "teacher": {
    "weights_dir": "../../../../teacher-eval/MicroAST/models",
    "style": "../../../../style-transfer/data/styles/vangogh/starry_night.jpg",
    "style_size": 256,
    "alpha": 1,
    "enabled": true
  },
  "loss": {
    "pixel": 1,
    "gradient": 2,
    "stroke": 0,
    "feature": 0,
    "tv": 0,
    "perceptual": 0,
    "style": 0,
    "vgg_weights": null
  },
  "optim": {
    "learning_rate": 0.0006,
    "beta_1": 0.9,
    "beta_2": 0.999,
    "epsilon": 1e-05,
    "iterations": 500,
    "schedule": {
      "kind": "constant"
    },
    "grad_clip": null
  },
  "student": {
    "arch": "tiny_dw",
    "options": {
      "base": 32,
      "res_blocks": 4,
      "mid": 48,
      "fine": 24,
      "plugin": "film",
      "plugin_site": "h4"
    }
  }
}
