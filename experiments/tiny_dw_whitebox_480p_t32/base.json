{
  "run": {
    "name": "res",
    "output_dir": "trials/base",
    "seed": 0,
    "device": "d0",
    "log_every": 50,
    "val_every": 0,
    "val_batch_size": 4,
    "checkpoint_every": 500,
    "sample_every": 500,
    "sample_limit": 6,
    "sample_content": "../../../style-transfer/demo_inputs",
    "sample_size": 640,
    "init_from": "init/res/model.mpk"
  },
  "data": {
    "content_dir": "../../../style-transfer/demo_inputs",
    "hf": {
      "repo": "detection-datasets/coco",
      "split": "train",
      "max_shards": 10
    },
    "pseudo_gt_dir": null,
    "crop": 192,
    "frame": {
      "width": 640,
      "height": 480
    },
    "batch_size": 16,
    "limit": null
  },
  "teacher": {
    "kind": "whitebox",
    "model": "../../../teachers/whitebox/cartoonizer.onnx",
    "enabled": true
  },
  "loss": {
    "pixel": 1,
    "gradient": 2,
    "flat": 10,
    "edge": 0,
    "contrast": 0,
    "stroke": 8,
    "texture": 0,
    "feature": 0,
    "tv": 0,
    "perceptual": 0,
    "style": 0,
    "vgg_weights": null,
    "line": 1
  },
  "optim": {
    "learning_rate": 0.00015,
    "beta_1": 0.9,
    "beta_2": 0.999,
    "epsilon": 1e-05,
    "iterations": 2000,
    "schedule": {
      "kind": "linear",
      "final_lr": 0.000015,
      "num_iters": 2000
    },
    "grad_clip": null
  },
  "student": {
    "arch": "tiny_dw_guided",
    "options": {
      "base": 16,
      "trunk": 32,
      "res_blocks": 1,
      "up_h4": 12,
      "up_h2": 20,
      "guide": 4,
      "full": 0,
      "film_h2": 1,
      "film_full": 0,
      "trunk_at": "h4",
      "h2_guide": 5,
      "in_eps": 1e-05,
      "pre_in_gain": "sqrt2",
      "trunk_norm_kind": "ln"
    }
  }
}
